# Backend Environment Variables Template
# ⚠️ CRITICAL: Copy this to .env and fill in your actual values
# ⚠️ NEVER commit .env to git! (.gitignore protects it)

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5433/dtg_ticket_db"

# Admin Credentials (for seeding initial admin user)
ADMIN_EMAIL="your.email@example.com"
ADMIN_PASSWORD="change_this_strong_password_in_production"
ADMIN_NAME="Admin Name"

# Server Configuration
PORT=4000

# DigitalOcean Spaces Configuration
# ⚠️ CRITICAL: These are SECRET admin keys! Never expose or commit these!
# Regenerate at: https://cloud.digitalocean.com/account/api/tokens

DO_SPACES_ENDPOINT=sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=your-space-name

# Primary Spaces Access Keys
DO_SPACES_KEY=YOUR_ACCESS_KEY_HERE                    # ❌ SECRET - Full admin access
DO_SPACES_SECRET=YOUR_SECRET_KEY_HERE                 # ❌ SECRET - Regenerate if exposed

# Secondary Spaces Keys (for attachments, if using separate keys)
DO_SPACES_ATTACHMENTS_ACCESS_KEY=YOUR_ACCESS_KEY_HERE # ❌ SECRET - Optional
DO_SPACES_ATTACHMENTS_SECRET_KEY=YOUR_SECRET_KEY_HERE # ❌ SECRET - Optional
DO_SPACES_CDN_URL=https://your-space-name.sgp1.cdn.digitaloceanspaces.com

# Firebase Admin SDK
# ⚠️ CRITICAL: Download firebase-service-account.json separately
# Location: Firebase Console > Project Settings > Service Accounts > Generate Key
# Save as: backend/firebase-service-account.json
# This file has FULL admin access - protect it!

# 🔒 SECURITY CHECKLIST:
# [ ] .env is in .gitignore (protected ✅)
# [ ] firebase-service-account.json is in .gitignore (protected ✅)
# [ ] Using strong database password
# [ ] Using strong admin password
# [ ] Different keys for dev/staging/production
# [ ] Keys are rotated every 90 days
# [ ] 2FA enabled on DigitalOcean account
# [ ] 2FA enabled on Firebase account

# ⚠️ IF KEYS ARE EXPOSED:
# 1. Regenerate DO Spaces keys immediately at DigitalOcean dashboard
# 2. Delete old Firebase service account, generate new one
# 3. Change database password
# 4. Review access logs for suspicious activity

