generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}
model Customer {
  id            String      @id
  name          String
  phone         String[]
  serviceTypeId String?
  splitter      String?
  splitterMap   String?

  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])
  tickets       Ticket[]
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Technician {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  picture   String

  leadsTeam Team[]
  tickets   Ticket[]
}

model ServiceType {
  id        String   @id
  name      String
  speedMbps Int

  customers Customer[]
}

model SLAOption {
  id    String @id
  value String
}

model Priority {
  id      String   @id
  display String
  tickets Ticket[]
}

model RootCause {
  id      String   @id
  name    String
  tickets Ticket[]
}

model Ticket {
  id               String        @id
  customerId       String
  sla              String
  complaint        String
  status           TicketStatus  @default(NEW)

  priorityId       String
  technicianId     Int?

  issueTime        DateTime
  startTime        DateTime?
  completionTime   DateTime?

  rootCauseId      String?
  rootCauseDetails String?
  wayToFix         String?

  materialsUsed    Json?
  totalCost        Float?
  attachments      Json?
  faultCoordinate  Json?
  breakTimes       Json?

  customer         Customer     @relation(fields: [customerId], references: [id])
  priority         Priority     @relation(fields: [priorityId], references: [id])
  rootCause        RootCause?   @relation(fields: [rootCauseId], references: [id])
  technician       Technician? @relation(fields: [technicianId], references: [id])
}

model Team {
  id               String     @id @default(cuid())
  name             String
  leaderId         Int
  memberIds        Json
  specialization   String
  activeTickets    Int
  completedTickets Int
  location         String
  status           String
  leader           Technician @relation(fields: [leaderId], references: [id])
}

model MaterialCatalog {
  id       Int    @id @default(autoincrement())
  name     String
  unitCost Float
}
