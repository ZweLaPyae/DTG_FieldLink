generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String       @id
  name          String
  serviceTypeId String?
  splitter      String?
  splitterMap   String?
  phone         String[]
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])
  tickets       Ticket[]
}

model AdminUser {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String?
  role         String     @default("admin")
  phone        String?
  picture      String?
  fcmToken     String?    // Firebase Cloud Messaging token for push notifications
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  logs         AdminLog[]
}

model Technician {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String[]
  picture      String
  passwordHash String
  fcmToken     String?  // Firebase Cloud Messaging token for push notifications
  leadsTeam    Team[]
}

model ServiceType {
  id        String     @id
  name      String
  speedMbps Int
  customers Customer[]
}

model Priority {
  id      String   @id
  display String
  tickets Ticket[]
}

model RootCause {
  id      String   @id
  name    String
  tickets Ticket[]
}

model Ticket {
  id                      String       @id
  customerId              String
  complaint               String
  priorityId              String
  issueTime               DateTime
  startTime               DateTime?
  technicianCompletionTime DateTime?   // When technician completes work and requests review
  completionTime          DateTime?    // When admin completes the ticket review
  rootCauseId             String?
  rootCauseDetails        String?
  wayToFix                String?
  totalCost               Float?
  attachments             Json?        // Photos/videos uploaded by technicians
  status                  TicketStatus @default(NEW)
  faultCoordinate         Json?
  breakTimes              Json?
  materialsUsed           Json?
  technicianNote          String?
  teamId                  Int?
  customer                Customer     @relation(fields: [customerId], references: [id])
  priority                Priority     @relation(fields: [priorityId], references: [id])
  rootCause               RootCause?   @relation(fields: [rootCauseId], references: [id])
  team                    Team?        @relation(fields: [teamId], references: [id])
}

model Team {
  id               Int        @id @default(autoincrement())
  name             String
  leaderId         Int
  memberIds        Json
  specialization   String
  activeTickets    Int        @default(0)
  completedTickets Int        @default(0)
  location         String
  status           String     @default("active")
  leader           Technician @relation(fields: [leaderId], references: [id])
  Ticket           Ticket[]
}

model MaterialCatalog {
  id              Int          @id @default(autoincrement())
  name            String
  unitCost        Float
  referenceLength Float?
  unit            MaterialUnit @default(PIECE)
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum MaterialUnit {
  PIECE
  METER
}

model AdminLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  
  @@index([createdAt])
  @@index([adminUserId])
}

model Notification {
  id           Int      @id @default(autoincrement())
  userId       Int      // Either admin ID or technician ID
  userType     String   // 'admin' or 'technician'
  title        String
  body         String
  type         String   // 'ticket_created', 'ticket_assigned', 'ticket_review_requested', 'ticket_completed', 'ticket_in_progress'
  ticketId     String?  // Related ticket ID
  data         Json?    // Additional data
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  
  @@index([userId, userType])
  @@index([createdAt])
  @@index([read])
}
