generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String       @id
  name          String
  serviceTypeId String?
  splitter      String?
  splitterMap   String?
  phone         String[]
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])
  tickets       Ticket[]
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Technician {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String[]
  picture      String
  passwordHash String
  leadsTeam    Team[]
}

model ServiceType {
  id        String     @id
  name      String
  speedMbps Int
  customers Customer[]
}

model SLAOption {
  id    String @id
  value String
}

model Priority {
  id      String   @id
  display String
  tickets Ticket[]
}

model RootCause {
  id      String   @id
  name    String
  tickets Ticket[]
}

model Ticket {
  id               String       @id
  customerId       String
  sla              String
  complaint        String
  priorityId       String
  issueTime        DateTime
  startTime        DateTime?
  completionTime   DateTime?
  rootCauseId      String?
  rootCauseDetails String?
  wayToFix         String?
  totalCost        Float?
  attachments      Json?
  status           TicketStatus @default(NEW)
  faultCoordinate  Json?
  breakTimes       Json?
  materialsUsed    Json?
  technicianNote   String?
  teamId           Int?
  customer         Customer     @relation(fields: [customerId], references: [id])
  priority         Priority     @relation(fields: [priorityId], references: [id])
  rootCause        RootCause?   @relation(fields: [rootCauseId], references: [id])
  team             Team?        @relation(fields: [teamId], references: [id])
}

model Team {
  name             String
  leaderId         Int
  memberIds        Json
  specialization   String
  activeTickets    Int        @default(0)
  completedTickets Int        @default(0)
  location         String
  status           String     @default("active")
  id               Int        @id @default(autoincrement())
  leader           Technician @relation(fields: [leaderId], references: [id])
  Ticket           Ticket[]
}

model MaterialCatalog {
  id              Int          @id @default(autoincrement())
  name            String
  unitCost        Float
  referenceLength Float?
  unit            MaterialUnit @default(PIECE)
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum MaterialUnit {
  PIECE
  METER
}
